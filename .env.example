# Local-first mode is the default. Exports and project-file saves do not require
# login unless this is set to true.
NEXT_PUBLIC_TUZUO_REQUIRE_AUTH=false

# Required when hosted registration emails are enabled. Use the full public
# origin, for example https://charts.example.com.
APP_BASE_URL=http://localhost:3000

# Optional in local development. When true, registration returns the verification
# link in the API response even if no email provider is configured.
AUTH_DEV_SHOW_VERIFICATION_LINK=true

# Required only when real email verification should be sent.
RESEND_API_KEY=
EMAIL_FROM="知图 <no-reply@example.com>"
